#cloud-config
# https://cloudinit.readthedocs.io/
hostname: '${HOST}'
manage_etc_hosts: true
timezone: '${TIME_ZONE}'
locale: '${LOCALE}'
keyboard:
  layout: '${KEYBOARD_LAYOUT_LANG}'
enable_ssh: '${SSH_ENABLED}'
ssh_pwauth: '${SSH_PASS_ENABLED}'
groups:
  - '${USER}': ['${USER}']
  - 'docker': ['docker']
users:
  - name: '${USER}'
    # gecos: Mr. Robot
    primary_group: '${USER}'
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    # ssh_import_id: foobar
    lock_passwd: false
    passwd: '${PASSWD}'
    sudo: ALL=(ALL) NOPASSWD:ALL  # Allow passwordless sudo for this user
runcmd: []  # per-once
bootcmd: []  # per-boot
